{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "porchline.profile",
  "title": "Porchline business profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["confirmed", "sourceCallId"],
  "properties": {
    "businessName": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["food", "personal_care", "home_services", "other", ""]
    },
    "summary": { "type": "string" },
    "phone": { "type": "string" },
    "email": { "type": ["string", "null"] },
    "address": { "type": ["string", "null"] },
    "serviceArea": { "type": ["string", "null"] },
    "hours": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/day" }
    },
    "services": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/service" }
    },
    "highlight": { "type": ["string", "null"] },
    "vibe": {
      "type": ["string", "null"],
      "description": "Short feel words for the site, such as warm, modern, or classic."
    },
    "look": {
      "type": ["string", "null"],
      "description": "Color or visual direction in the owner's words, such as deep green and cream."
    },
    "heroLine": {
      "type": ["string", "null"],
      "description": "Optional headline for the top of the page."
    },
    "audience": {
      "type": ["string", "null"],
      "description": "Who the page should speak to, such as families nearby or office workers."
    },
    "siteSlug": {
      "type": "string",
      "description": "Internal Netlify site name slug only. Not a public subdomain.",
      "pattern": "^(|[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)$"
    },
    "confirmed": { "type": "boolean" },
    "sourceCallId": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed"],
      "properties": {
        "closed": { "type": "boolean" },
        "open": { "type": ["string", "null"] },
        "close": { "type": ["string", "null"] }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "priceLabel": { "type": ["string", "null"] },
        "blurb": { "type": ["string", "null"] }
      }
    }
  }
}
