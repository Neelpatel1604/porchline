{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "porchline.profile",
  "title": "Porchline business profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "businessName",
    "category",
    "summary",
    "phone",
    "hours",
    "services",
    "subdomainLabel",
    "confirmed",
    "sourceCallId"
  ],
  "properties": {
    "businessName": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["food", "personal_care", "home_services", "other"]
    },
    "summary": { "type": "string", "minLength": 1 },
    "phone": { "type": "string", "minLength": 3 },
    "email": { "type": ["string", "null"] },
    "address": { "type": ["string", "null"] },
    "serviceArea": { "type": ["string", "null"] },
    "hours": { "$ref": "#/$defs/week" },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/service" }
    },
    "highlight": { "type": ["string", "null"] },
    "subdomainLabel": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
    },
    "confirmed": { "type": "boolean" },
    "sourceCallId": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed"],
      "properties": {
        "closed": { "type": "boolean" },
        "open": { "type": ["string", "null"] },
        "close": { "type": ["string", "null"] }
      }
    },
    "week": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monday",
        "tuesday",
        "wednesday",
        "thursday",
        "friday",
        "saturday",
        "sunday"
      ],
      "properties": {
        "monday": { "$ref": "#/$defs/day" },
        "tuesday": { "$ref": "#/$defs/day" },
        "wednesday": { "$ref": "#/$defs/day" },
        "thursday": { "$ref": "#/$defs/day" },
        "friday": { "$ref": "#/$defs/day" },
        "saturday": { "$ref": "#/$defs/day" },
        "sunday": { "$ref": "#/$defs/day" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "priceLabel": { "type": ["string", "null"] },
        "blurb": { "type": ["string", "null"] }
      }
    }
  }
}
