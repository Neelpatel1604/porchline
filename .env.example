# Copy to .env in the repo root and fill these in when you have them.
# Both apps read this file. Do not commit .env.

# Voice — required to place a Higgs call
BOSON_API_KEY=
BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime/
BOSON_REALTIME_MODEL=higgs-realtime

# Phone — required for a real Twilio call
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public websocket Twilio streams to, for example wss://your-tunnel.example/twilio/stream
PUBLIC_VOICE_WSS_URL=

# Shared by voice and web
WEB_BASE_URL=http://localhost:3000
VOICE_BASE_URL=http://localhost:8000
INTERNAL_SHARED_SECRET=replace-with-a-long-random-string
DATABASE_PATH=data/porchline.db

# Web — required to deploy. The app still boots if these are empty.
PORCHLINE_PARENT_DOMAIN=
NETLIFY_AUTH_TOKEN=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
