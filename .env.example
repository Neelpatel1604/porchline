# Copy to .env in the repo root and fill these in when you have them.
# Both apps read this file. Do not commit .env.

# Voice - required to place a Higgs call
BOSON_API_KEY=
BOSON_REALTIME_URL=wss://api.boson.ai/v1/realtime/
BOSON_REALTIME_MODEL=higgs-realtime
# Optional ISO-639-1 STT hint (e.g. es, hi). Leave empty for auto-detect / match the caller.
BOSON_STT_LANGUAGE=

# Phone - required for a real Twilio call
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Porchline Twilio number used as From for SMS (optional; looks up the first number if empty)
TWILIO_PHONE_NUMBER=
# Public websocket Twilio streams to, for example wss://your-tunnel.example/twilio/stream
PUBLIC_VOICE_WSS_URL=

# Shared by voice and web
WEB_BASE_URL=http://localhost:3000
# Netlify dashboard: set this to the public HTTPS voice URL (not localhost).
VOICE_BASE_URL=http://localhost:8000
# Where the phone agent posts publish (Gemini + Netlify zip). Use the voice host on EC2,
# not the Netlify Next app, or Netlify will 504 while Gemini thinks.
PUBLISH_BASE_URL=http://127.0.0.1:8000
# On EC2: keep PUBLISH_BASE_URL as 127.0.0.1:8000 (same voice process). Do not point it at Netlify.
# Optional HTTPS origin if PUBLIC_VOICE_WSS_URL is not enough to derive Connect action URL.
VOICE_PUBLIC_HTTP_URL=
# Voice CORS: comma-separated dashboard origins (Netlify URL). WEB_BASE_URL is also allowed.
CORS_ORIGINS=
INTERNAL_SHARED_SECRET=replace-with-a-long-random-string
DATABASE_PATH=data/porchline.db

# Required on the voice host to deploy sites (publish runs on EC2 now).
NETLIFY_AUTH_TOKEN=

# Site builder - Gemini designs the page after spoken yes. Falls back to the template if empty.
GEMINI_API_KEY=
SITE_BUILDER_MODEL=gemini-4-argon
