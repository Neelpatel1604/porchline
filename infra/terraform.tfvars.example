# Copy to terraform.tfvars (gitignored) and fill in.
# Run: terraform login ; terraform init

aws_region   = "us-east-1"
instance_name = "porchline-voice"
instance_type = "t3.small"

# Must already exist in this region (EC2 → Key pairs).
key_name = "porchline"

# Your public IP with /32, e.g. "203.0.113.10/32"
ssh_cidr = "x.x.x.x/32"

root_volume_gb        = 30
associate_elastic_ip  = true
